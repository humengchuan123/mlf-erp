# Application
APP_NAME=mlf-erp
APP_ENV=dev
APP_DELIVERY_MODE=saas
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# HTTP
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated proxy CIDRs. Leave empty when there is no reverse proxy.
HTTP_TRUSTED_PROXIES=

# PostgreSQL
DB_ENABLED=true
DB_REQUIRED=true
DATABASE_URL=postgres://mlf:mlf@localhost:5432/mlf_erp?sslmode=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth
JWT_SECRET=dev-only-change-me
JWT_ISSUER=mlf-erp
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Idempotency
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_REQUIRED=false
IDEMPOTENCY_MAX_BODY_BYTES=1048576
IDEMPOTENCY_MAX_RESPONSE_BYTES=4194304
IDEMPOTENCY_CLEANUP_INTERVAL=1h

# RabbitMQ / MinIO (reserved for integration adapters)
RABBITMQ_URL=amqp://mlf:mlf@localhost:5672/
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=mlf
MINIO_SECRET_KEY=mlf-secret
MINIO_BUCKET=mlf-erp

# Logging
LOG_LEVEL=debug
